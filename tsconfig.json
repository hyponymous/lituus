{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite/client", "@webgpu/types"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "experiments/katago/**/*.ts",
    "experiments/browser/**/*.ts"
  ],
  "exclude": [
    "experiments/browser/bench.ts",
    "experiments/browser/mobile.ts",
    "experiments/browser/vite.mobile.config.ts"
  ]
}
